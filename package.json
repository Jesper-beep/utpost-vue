{
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@cspell/dict-sv": "^2.3.2",
		"concurrently": "^9.1.2",
		"cspell": "^10.3.4",
		"husky": "^9.1.7",
		"markdownlint-cli": "^0.49.1",
		"typescript": "~6.0.0"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"name": "utpost",
	"overrides": {
		"js-yaml": "^5.4.1",
		"katex": "^0.18.2",
		"shell-quote": "^1.9.0",
		"smol-toml": "^1.9.0"
	},
	"private": true,
	"scripts": {
		"build": "npm run build --workspace=client",
		"dev": "concurrently -n api,web,client -c blue,green,magenta \"npm run dev --workspace=api\" \"npm run dev --workspace=web\" \"npm run dev --workspace=client\"",
		"dev:api": "npm run dev --workspace=api",
		"dev:client": "npm run dev --workspace=client",
		"dev:web": "npm run dev --workspace=web",
		"docker:client:start": "docker compose start client",
		"docker:client:stop": "docker compose stop client",
		"docker:db": "docker compose up -d postgres",
		"docker:down": "docker compose down",
		"docker:reset": "docker compose down -v",
		"docker:seed": "docker compose exec api npm run seed",
		"docker:up": "docker compose up --build -d",
		"lint": "biome check --verbose --diagnostic-level=warn --max-diagnostics=none .",
		"lint:fix": "biome check --write .",
		"lint:force-fix": "biome check --write --unsafe .",
		"lint:md": "markdownlint \"**/*.md\" --ignore \"**/node_modules/**\"",
		"lint:md:fix": "markdownlint \"**/*.md\" --ignore \"**/node_modules/**\" --fix",
		"lint:spelling": "cspell \"**/*.{js,jsx,md}\"",
		"prepare": "husky",
		"seed": "npm run seed --workspace=api",
		"test": "npm run test --workspace=client && npm run test --workspace=api",
		"typecheck": "npm run typecheck --workspace=client && npm run typecheck --workspace=api"
	},
	"version": "1.4.2",
	"workspaces": [
		"api",
		"web",
		"client",
		"shared"
	]
}
