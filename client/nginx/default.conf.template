server {
	listen 3001;
	server_tokens off;
	root /usr/share/nginx/html;
	index index.html;

	gzip on;
	gzip_vary on;
	gzip_min_length 1024;
	gzip_types text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml image/x-icon;

	include /etc/nginx/headers.conf;

	resolver 127.0.0.11 valid=10s;

	location = /health {
		access_log off;
		default_type text/plain;
		return 200 "ok\n";
	}

	location = /api/photos {
		client_max_body_size 11m;
		set $api ${API_PROXY_TARGET};
		include /etc/nginx/proxy.conf;
	}

	location ~ ^/(api|uploads|graphql)(/|$) {
		client_max_body_size 1m;
		set $api ${API_PROXY_TARGET};
		include /etc/nginx/proxy.conf;
	}

	location /assets/ {
		try_files $uri =404;
	}

	location / {
		try_files $uri /index.html;
	}
}
