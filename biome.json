{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedKeys": {
					"level": "on",
					"options": {
						"sortOrder": "natural"
					}
				}
			}
		},
		"enabled": true
	},
	"files": {
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "lf",
		"useEditorconfig": true
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": { "enabled": true }
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"linter": {
		"domains": {
			"vue": "recommended"
		},
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noVueOptionsApi": "warn",
				"useVueDefineMacrosOrder": "warn",
				"useVueMultiWordComponentNames": "warn"
			}
		}
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
