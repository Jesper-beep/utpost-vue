{
	"dependencies": {
		"@envelop/rate-limiter": "^11.0.1",
		"@utpost/shared": "*",
		"dataloader": "^2.2.3",
		"drizzle-orm": "^0.45.3",
		"express": "^5.0.0",
		"express-rate-limit": "^8.7.4",
		"graphql": "^17.0.2",
		"graphql-yoga": "^6.1.0",
		"jsonwebtoken": "^9.0.2",
		"mongodb": "^7.7.0",
		"pg": "^8.13.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/express": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"typescript": "~6.0.0",
		"vitest": "^5.0.1"
	},
	"name": "@utpost/api",
	"private": true,
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
		"db:push": "drizzle-kit push",
		"dev": "node --watch --env-file-if-exists=.env src/server.ts",
		"migrate:logs": "node --env-file-if-exists=.env src/db/migrate-logs.ts",
		"seed": "node --env-file-if-exists=.env src/db/seed.ts",
		"start": "node --env-file-if-exists=.env src/server.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"type": "module",
	"version": "1.4.2"
}
